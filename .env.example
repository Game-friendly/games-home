# 后端
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/order_platform
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=postgres123
JPA_DDL_AUTO=update
JWT_SECRET=please-generate-a-random-secret-at-least-32-bytes-long
JWT_EXPIRE_MINUTES=1440

# 演示数据：本地 true，生产 false
SEED_DEMO_DATA=true
UPLOAD_DIR=./uploads

# 微信（拿到资质后填写）
WECHAT_ENABLED=false
WECHAT_APPID=
WECHAT_SECRET=

# 业务参数
RESERVE_SECONDS=120
MIN_ACCEPT_CREDIT=60
GRADE_UP_MIN_COMPLETED=10
GRADE_UP_MIN_RATING=4.5
GRADE_UP_MIN_CREDIT=80
GRADE_DOWN_MAX_CREDIT=40
AUTO_DISPATCH_ENABLED=false
AUTO_DISPATCH_AFTER_MINUTES=30
