.login { padding-top: 48rpx; }
.hero { display: flex; flex-direction: column; align-items: center; margin: 40rpx 0 56rpx; }
.logo { font-size: 52rpx; font-weight: 700; color: #1a1a2e; }
.slogan { margin-top: 16rpx; color: #999; font-size: 26rpx; }
