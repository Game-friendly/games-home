.topbar { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; height: 88rpx; padding: 0 24rpx; background: #111318; color: #fff; }
.back { color: #fff; font-size: 30rpx; margin-right: 20rpx; }
.profile { display: flex; align-items: center; gap: 20rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: #fff4d6; display: flex; align-items: center; justify-content: center; font-size: 48rpx; }
.profile-main { flex: 1; min-width: 0; }
.name { font-size: 34rpx; font-weight: 800; }
.stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin-top: 24rpx; text-align: center; }
.stat { display: flex; flex-direction: column; gap: 6rpx; }
.stat-num { color: #e03131; font-weight: 800; font-size: 30rpx; }
.sec-title { font-weight: 700; margin-bottom: 16rpx; }
.review { padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.stars { color: #f7b500; margin-right: 16rpx; }
.empty { text-align: center; color: #999; padding: 40rpx 0; }
