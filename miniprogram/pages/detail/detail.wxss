.row { display: flex; align-items: center; justify-content: space-between; }
.title { font-size: 34rpx; font-weight: 700; margin: 16rpx 0; }
.price { color: #e03131; font-size: 36rpx; font-weight: 700; margin-bottom: 12rpx; }
.desc { margin: 12rpx 0 20rpx; color: #555; }
.countdown { text-align: center; }
.remain { color: #e88a00; font-weight: 700; font-size: 32rpx; }
.actions { padding: 30rpx 20rpx; display: flex; flex-direction: column; gap: 20rpx; }
.btn-ghost { background: #fff; color: #1a1a2e; border: 1rpx solid #1a1a2e; border-radius: 12rpx; }
.review { text-align: center; }
.stars { margin-bottom: 16rpx; }
.star { font-size: 56rpx; color: #ddd; padding: 0 8rpx; }
.star.on { color: #ffb400; }
.sec-title { font-weight: 700; margin-bottom: 16rpx; }
.img-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.order-img { width: 180rpx; height: 180rpx; border-radius: 8rpx; }
.slot { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.slot:last-child { border-bottom: 0; }
.slot-main { display: flex; flex-direction: column; gap: 6rpx; }
.slot-btn { margin: 0; width: 140rpx; height: 64rpx; line-height: 64rpx; font-size: 28rpx; padding: 0; }
.review { margin-top: 20rpx; text-align: center; }
.topbar { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; height: 88rpx; padding: 0 24rpx; background: #111318; color: #fff; }
.back { color: #fff; font-size: 30rpx; margin-right: 20rpx; }
.chat-list { max-height: 480rpx; }
.chat-msg { display: flex; flex-direction: column; margin-bottom: 20rpx; }
.chat-meta { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.chat-name { font-size: 24rpx; font-weight: 700; color: #17181c; }
.chat-bubble { background: #f4f5f7; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; color: #17181c; max-width: 85%; }
.chat-msg.mine { align-items: flex-end; }
.chat-msg.mine .chat-bubble { background: #fff4d6; }
.chat-input { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.chat-input input { flex: 1; border: 1rpx solid #e3e6eb; border-radius: 12rpx; padding: 14rpx 20rpx; font-size: 28rpx; }
