.home-header { background: #111318; color: #fff; padding: 20rpx 24rpx 28rpx; }
.header-row { display: flex; align-items: center; justify-content: space-between; }
.brand { font-weight: 800; font-size: 36rpx; color: #fff; }
.header-actions { display: flex; gap: 12rpx; }
.filters { display: flex; gap: 16rpx; margin-top: 16rpx; }
.filter-item { flex: 1; text-align: center; background: #fff; border-radius: 12rpx; padding: 12rpx 0; font-size: 24rpx; color: #17181c; }
.category-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 24rpx; }
.cat-tile { background: #fff; border-radius: 16rpx; padding: 20rpx 10rpx; text-align: center; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.06); }
.cat-icon { width: 76rpx; height: 76rpx; margin: 0 auto 10rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.cat-label { font-size: 22rpx; font-weight: 700; color: #17181c; }
.section-title { padding: 28rpx 24rpx 4rpx; font-size: 28rpx; font-weight: 800; color: #17181c; }
.worker-list { display: flex; flex-direction: column; gap: 16rpx; padding: 16rpx 24rpx; }
.worker { display: flex; align-items: center; gap: 16rpx; background: #fff; border-radius: 16rpx; padding: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.worker-avatar { width: 84rpx; height: 84rpx; border-radius: 50%; background: #fff4d6; display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.worker-main { flex: 1; min-width: 0; }
.worker-name { font-weight: 800; font-size: 28rpx; }
.worker-meta { display: flex; align-items: center; gap: 10rpx; margin-top: 8rpx; }
.grade-tag { font-size: 20rpx; font-weight: 800; padding: 2rpx 12rpx; border-radius: 999rpx; }
.grade-A { background: #ffe8e8; color: #e03131; }
.grade-B { background: #fff3e0; color: #e88a00; }
.grade-C { background: #e8f0fe; color: #2f6fed; }
.worker-right { text-align: right; display: flex; flex-direction: column; gap: 4rpx; }
.loading-wrap, .empty-wrap { display: flex; align-items: center; justify-content: center; padding: 120rpx 0; }
.product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; padding: 20rpx; }
.product { background: #fff; border-radius: 16rpx; overflow: hidden; }
.thumb { position: relative; height: 180rpx; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24rpx; }
.thumb-icon { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); font-size: 56rpx; opacity: .9; }
.thumb-cat { position: absolute; left: 12rpx; bottom: 10rpx; font-size: 22rpx; font-weight: 800; text-shadow: 0 1rpx 4rpx rgba(0,0,0,.3); }
.thumb-tag { position: absolute; top: 12rpx; left: 12rpx; }
.info { padding: 16rpx; }
.name { min-height: 76rpx; line-height: 38rpx; font-size: 28rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.price-row { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.price { color: #e03131; font-weight: 700; font-size: 30rpx; }
.muted { color: #777; font-size: 24rpx; }
